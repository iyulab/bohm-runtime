<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bohm.Runtime.Host</RootNamespace>
  </PropertyGroup>

  <!-- The Bohm account (an AI the cloud service pays for) is in builds that carry it: Debug by default, never a release
       build until the cloud service is ready. A debug build reads the cloud's address from BOHM_CLOUD; a release build that
       carries the account has its address built in (BohmCloudUrl) and ignores the variable, so nothing on the computer can
       send the person's session elsewhere. `-p:BohmCloud=true -p:BohmCloudUrl=<address>` makes a release build for a
       staging cloud; `-p:BohmCloud=false` takes the account out of a debug one. -->
  <PropertyGroup>
    <BohmCloud Condition="'$(BohmCloud)' == '' and '$(Configuration)' == 'Debug'">true</BohmCloud>
    <BohmCloudUrl Condition="'$(BohmCloudUrl)' == ''">https://cloud.bohmbrowser.com/</BohmCloudUrl>
    <DefineConstants Condition="'$(BohmCloud)' == 'true'">$(DefineConstants);BOHM_CLOUD</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(BohmCloud)' == 'true' and '$(Configuration)' != 'Debug'">
    <AssemblyMetadata Include="BohmCloudUrl" Value="$(BohmCloudUrl)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Adoption\shim.js" LogicalName="Bohm.Runtime.Host.shim.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bohm.Runtime\Bohm.Runtime.csproj" />
  </ItemGroup>

  <!-- A JavaScript parser (no engine): an application's inline scripts are read before it is accepted, so a syntax
       error goes back to the model that wrote it instead of reaching the person. -->
  <ItemGroup>
    <PackageReference Include="Acornima" Version="1.8.0" />
  </ItemGroup>

  <!-- Each application on its own origin: security profile, injection, the storage channel, previews, ports. -->
  <ItemGroup>
    <PackageReference Include="LocalOrigin.AspNetCore" Version="0.4.1" />
    <PackageReference Include="TauriKit.Sidecar.Loopback.AspNetCore" Version="0.30.0" />
    <!-- The Windows Credential Manager entries a tauri-kit shell shares (Credentials/WindowsCredentialVault.cs). -->
    <PackageReference Include="TauriKit.Credentials" Version="0.30.0" />
  </ItemGroup>

  <!-- Durable files: settings replaced whole (temp sibling, flushed, one rename) and folders sent to the platform's trash. -->
  <ItemGroup>
    <PackageReference Include="DesktopHost.Files" Version="0.3.0" />
  </ItemGroup>

  <!-- Signing in to the Bohm account: OAuth 2.0 for native apps (RFC 8252) against the identity service the cloud names. -->
  <ItemGroup>
    <PackageReference Include="Authway.Native" Version="0.1.1" />
  </ItemGroup>

  <!--
    A model on this computer answering applications' AI requests (GGUF through llama-server), and the
    conversion between the OpenAI chat wire shape and Microsoft.Extensions.AI.
  -->
  <ItemGroup>
    <PackageReference Include="IronHive.Agent" Version="0.78.0" />
    <PackageReference Include="IronHive.Extensions.AI" Version="0.72.0" />
    <PackageReference Include="IronHive.Providers.Anthropic" Version="0.72.0" />
    <PackageReference Include="IronHive.Providers.GoogleAI" Version="0.72.0" />
    <PackageReference Include="IronHive.Providers.OpenAI" Version="0.72.0" />
    <PackageReference Include="IronHive.Providers.OpenAI.Compatible" Version="0.72.0" />
    <PackageReference Include="LMSupply.Generator" Version="0.138.0" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
  </ItemGroup>

  <!--
    A speech model on this computer turning applications' recordings into text (Whisper ONNX), on the native ONNX
    Runtime shipped with the runtime: referenced directly so its native library comes along (the model library takes
    only the managed part and would otherwise fetch the native one at first use), and kept out of the single file so it
    loads from the runtime's directory.
  -->
  <ItemGroup>
    <PackageReference Include="LMSupply.Transcriber" Version="0.138.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>

  <Target Name="KeepOnnxRuntimeBesideTheExecutable" AfterTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <_PublishesForWindows>$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))</_PublishesForWindows>
    </PropertyGroup>
    <ItemGroup>
      <!-- The package's props add its win-x64 libraries to every x64/AnyCPU output, whatever the runtime identifier: a
           publish for another system takes its own library (libonnxruntime.dylib, .so) from runtimes/<rid>/native and
           must not carry the Windows ones. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'$(_PublishesForWindows)' != 'true' And '%(Extension)' == '.dll' And $([System.String]::Copy('%(Filename)').StartsWith('onnxruntime'))" />
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
        Condition="('%(Extension)' == '.dll' Or '%(Extension)' == '.dylib' Or '%(Extension)' == '.so') And ($([System.String]::Copy('%(Filename)').StartsWith('onnxruntime')) Or $([System.String]::Copy('%(Filename)').StartsWith('libonnxruntime')))"
        ExcludeFromSingleFile="true" />
      <!-- The import libraries are for linking against it, not for running. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.lib' And $([System.String]::Copy('%(Filename)').StartsWith('onnxruntime'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Bohm.Runtime.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in skills (SKILL.md folders) the make model reads on demand — loose files beside the executable, single-file or not. -->
    <None Include="Skills\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
