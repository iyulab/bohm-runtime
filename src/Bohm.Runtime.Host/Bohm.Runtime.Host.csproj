<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bohm.Runtime.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Adoption\shim.js" LogicalName="Bohm.Runtime.Host.shim.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bohm.Runtime\Bohm.Runtime.csproj" />
  </ItemGroup>

  <!-- Each application on its own origin: security profile, injection, the storage channel, previews, ports. -->
  <ItemGroup>
    <PackageReference Include="LocalOrigin.AspNetCore" Version="0.3.0" />
  </ItemGroup>

  <!--
    A model on this computer answering applications' AI requests (GGUF through llama-server), and the
    conversion between the OpenAI chat wire shape and Microsoft.Extensions.AI.
  -->
  <ItemGroup>
    <PackageReference Include="IronHive.Agent" Version="0.53.0" />
    <PackageReference Include="IronHive.Extensions.AI" Version="0.58.0" />
    <PackageReference Include="IronHive.Providers.Anthropic" Version="0.58.0" />
    <PackageReference Include="IronHive.Providers.GoogleAI" Version="0.58.0" />
    <PackageReference Include="IronHive.Providers.OpenAI" Version="0.58.0" />
    <PackageReference Include="IronHive.Providers.OpenAI.Compatible" Version="0.58.0" />
    <PackageReference Include="IronProw.LMSupply" Version="0.15.12" />
    <PackageReference Include="LMSupply.Generator" Version="0.115.1" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
  </ItemGroup>

  <!--
    A speech model on this computer turning applications' recordings into text (Whisper ONNX), on the native ONNX
    Runtime shipped with the runtime: referenced directly so its native library comes along (the model library takes
    only the managed part and would otherwise fetch the native one at first use), and kept out of the single file so it
    loads from the runtime's directory.
  -->
  <ItemGroup>
    <PackageReference Include="LMSupply.Transcriber" Version="0.115.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

  <Target Name="KeepOnnxRuntimeBesideTheExecutable" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.dll' And $([System.String]::Copy('%(Filename)').StartsWith('onnxruntime'))"
        ExcludeFromSingleFile="true" />
      <!-- The import libraries are for linking against it, not for running. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.lib' And $([System.String]::Copy('%(Filename)').StartsWith('onnxruntime'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Bohm.Runtime.Tests" />
  </ItemGroup>

</Project>
