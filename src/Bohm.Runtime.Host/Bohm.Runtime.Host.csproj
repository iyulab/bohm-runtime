<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bohm.Runtime.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Adoption\shim.js" LogicalName="Bohm.Runtime.Host.shim.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bohm.Runtime\Bohm.Runtime.csproj" />
  </ItemGroup>

  <!--
    A model on this computer answering applications' AI requests (GGUF through llama-server), and the
    conversion between the OpenAI chat wire shape and Microsoft.Extensions.AI.
  -->
  <ItemGroup>
    <PackageReference Include="IronHive.Agent" Version="0.23.0" />
    <PackageReference Include="IronHive.Extensions.AI" Version="0.44.0" />
    <PackageReference Include="IronHive.Providers.Anthropic" Version="0.44.0" />
    <PackageReference Include="IronHive.Providers.GoogleAI" Version="0.44.0" />
    <PackageReference Include="IronHive.Providers.OpenAI.Compatible" Version="0.44.0" />
    <PackageReference Include="IronProw.LMSupply" Version="0.8.9" />
    <PackageReference Include="LMSupply.Generator" Version="0.88.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bohm.Runtime.Tests" />
  </ItemGroup>

</Project>
